<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn wherever a cover would have been.

     This has to be a vector rather than a <shape>: Compose's painterResource
     only understands vector drawables and image files, and throws on anything
     else. A neutral grey at low opacity reads correctly on a light or a dark
     theme. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#1F808080"
        android:pathData="M0,0h24v24h-24z" />
</vector>
